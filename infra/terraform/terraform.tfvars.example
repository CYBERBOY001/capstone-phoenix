#######################################
# General
#######################################

project_name = "phoenix"

environment = "dev"

aws_region = "eu-west-2"

#######################################
# Network
#######################################

vpc_cidr = "10.0.0.0/16"

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24",
  "10.0.3.0/24"
]

availability_zones = [
  "eu-west-2a",
  "eu-west-2b",
  "eu-west-2c"
]

#

instance_type = "t3.small"

worker_count = 2

ami_id = "ami-xxxxxxxxxxxxxxxxx"

key_name = "your-keypair-name"



allowed_ssh_cidrs = [
  "YOUR_PUBLIC_IP/32"
]